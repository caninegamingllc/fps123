msgid "Asset references added: {0} · Rejected: {1} · Skipped: {2}"
msgstr "Referências de recursos adicionadas: {0} · Rejeitadas: {1} · Ignoradas: {2}"

#. Key:	AddedDetail
msgctxt "NativeAssetReferenceIngress,AddedDetail"
msgid "References contain asset paths and class names. Asset contents and image pixels are not attached."
msgstr "As referências contêm caminhos de assets e nomes de classes. Conteúdos dos assets e pixels de imagens não são anexados."

#. Key:	InvalidDetail
msgctxt "NativeAssetReferenceIngress,InvalidDetail"
msgid "Invalid or oversized asset metadata was rejected."
msgstr "Metadados de recurso inválidos ou grandes demais foram rejeitados."


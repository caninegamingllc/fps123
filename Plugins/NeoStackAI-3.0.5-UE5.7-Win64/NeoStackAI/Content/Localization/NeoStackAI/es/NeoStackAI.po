msgctxt "NeoStack.ClientReadiness,Clientbab7728fb7"
msgid "Automatic discovery is not available for this app surface on this platform. Choose its executable with Browse."
msgstr "La detección automática no está disponible para esta interfaz en esta plataforma. Elige su ejecutable con Examinar."

#. Key:	Client2b71f6076c
msgctxt "NeoStack.ClientReadiness,Client2b71f6076c"
msgid "A file was found, but it is not a supported executable for this app surface. Choose the desktop application or CLI launcher with Browse."
msgstr "Se encontró un archivo, pero no es un ejecutable compatible con esta interfaz. Elige la aplicación de escritorio o lanzador CLI con Examinar."


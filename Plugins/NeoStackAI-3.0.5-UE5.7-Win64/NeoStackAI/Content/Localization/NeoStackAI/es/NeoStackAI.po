msgctxt "NeoStack.ClientReadiness,Client9b53d47853"
msgid "Local check timed out. A filesystem lookup may still be finishing."
msgstr "La comprobación local agotó el tiempo de espera. Una búsqueda del sistema de archivos puede seguir terminando."


msgctxt "NeoStack.ClientConnectionOperation,Messageabbd610960"
msgid "The setup worker is unavailable. Try again shortly."
msgstr "El proceso de configuración no está disponible. Vuelve a intentarlo en breve."

#. Key:	Messagec793750533
msgctxt "NeoStack.ClientConnectionOperation,Messagec793750533"
msgid "The setup worker stopped or its queue is full. Check setup before retrying."
msgstr "El proceso de configuración se detuvo o su cola está llena. Comprueba la configuración antes de reintentar."

#. Key:	Messagee01acca90c
msgctxt "NeoStack.ClientConnectionOperation,Messagee01acca90c"
msgid "Setup cancelled before any changes."
msgstr "Configuración cancelada antes de realizar cambios."

#. Key:	Message7733a5b1c4
msgctxt "NeoStack.ClientConnectionOperation,Message7733a5b1c4"
msgid "The bundled connector is unavailable or invalid. Update or repair the NeoStack plugin."
msgstr "El conector incluido no está disponible o no es válido. Actualiza o repara el plugin NeoStack."

#. Key:	Messagecbfc662782
msgctxt "NeoStack.ClientConnectionOperation,Messagecbfc662782"
msgid "Check setup to prepare this connection again."
msgstr "Comprueba la configuración para preparar esta conexión de nuevo."

#. Key:	Client76384a9346
msgctxt "NeoStack.ClientReadiness,Client76384a9346"
msgid "Choose a supported client surface and an absolute project directory."

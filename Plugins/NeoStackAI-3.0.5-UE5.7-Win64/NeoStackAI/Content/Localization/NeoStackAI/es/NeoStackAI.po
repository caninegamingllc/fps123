#. Key:	UseHttpsOrAnHttpLocalhostEndpointForDevelopmentEmbeddedC2c457c
msgctxt "NeoStack.NativePluginSettingsStore,UseHttpsOrAnHttpLocalhostEndpointForDevelopmentEmbeddedC2c457c"
msgid "Use HTTPS, or an HTTP localhost endpoint for development. Embedded credentials are not supported."
msgstr "Usa HTTPS o un endpoint HTTP localhost para desarrollo. No se admiten credenciales incrustadas."

#. Key:	AnotherEditorIsSavingPluginSettingsTryAgainShortlyecfbcd
msgctxt "NeoStack.NativePluginSettingsStore,AnotherEditorIsSavingPluginSettingsTryAgainShortlyecfbcd"
msgid "Another editor is saving plugin settings. Try again shortly."
msgstr "Otro editor está guardando la configuración del plugin. Reintenta en breve."

#. Key:	ThisSettingChangedInAnotherEditorReopenThisPageToReloadIcde467
msgctxt "NeoStack.NativePluginSettingsStore,ThisSettingChangedInAnotherEditorReopenThisPageToReloadIcde467"
msgid "This setting changed in another editor. Reopen this page to reload it before saving."
msgstr "Este ajuste cambió en otro editor. Reabre esta página para recargarlo antes de guardar."

#. Key:	Setting1b7c919c96
msgctxt "NeoStack.NativePluginSettingsStore,Setting1b7c919c96"
msgid "Check for plugin updates when Unreal starts. You can always check manually."
msgstr "Buscar actualizaciones del plugin al iniciar Unreal. Siempre puedes comprobar manualmente."

#. Key:	Settingc621da3e65
msgctxt "NeoStack.NativePluginSettingsStore,Settingc621da3e65"
msgid "Check on startup"
msgstr "Comprobar al iniciar"

#. Key:	PluginSettingsExceedTheSupported1MibLimitca0bbb
msgctxt "NeoStack.NativePluginSettingsStore,PluginSettingsExceedTheSupported1MibLimitca0bbb"
msgid "Plugin settings exceed the supported 1 MiB limit."
msgstr "La configuración del plugin supera el límite admitido de 1 MiB."

#. Key:	Settingc1b23c6508
msgctxt "NeoStack.NativePluginSettingsStore,Settingc1b23c6508"
msgid "Include beta releases"
msgstr "Incluir versiones beta"

#. Key:	Settingf4b5331272
msgctxt "NeoStack.NativePluginSettingsStore,Settingf4b5331272"
msgid "Offer preview builds as well as stable releases. Applies to the next update check."
msgstr "Ofrecer versiones preliminares además de estables. Se aplica a la próxima búsqueda de actualizaciones."

#. Key:	Setting114cdf5408
msgctxt "NeoStack.NativePluginSettingsStore,Setting114cdf5408"
msgid "Optional usage analytics"
msgstr "Análisis de uso opcional"

#. Key:	Settinge1d12c7004
msgctxt "NeoStack.NativePluginSettingsStore,Settinge1d12c7004"
msgid "Share product usage events. Turning this off also stops automatic crash reports."
msgstr "Compartir eventos de uso del producto. Desactivarlo también detiene los informes automáticos de fallos."

#. Key:	Setting95f5618be3
msgctxt "NeoStack.NativePluginSettingsStore,Setting95f5618be3"
msgid "Automatic crash diagnostics"
msgstr "Diagnóstico automático de fallos"

#. Key:	Settingc151e33fda
msgctxt "NeoStack.NativePluginSettingsStore,Settingc151e33fda"
msgid "Share basic crash metadata when usage analytics is enabled. Full logs always require review and an explicit send."
msgstr "Compartir metadatos básicos de fallos si el análisis de uso está activo. Los registros completos siempre requieren revisión y envío explícito."

#. Key:	Setting18054401ca
msgctxt "NeoStack.NativePluginSettingsStore,Setting18054401ca"
msgid "Connect to NeoStack Desktop"
msgstr "Conectar a NeoStack Desktop"

#. Key:	Setting559dc41d9a
msgctxt "NeoStack.NativePluginSettingsStore,Setting559dc41d9a"
msgid "Discover the desktop app automatically for this project. Restart to apply."
msgstr "Detectar automáticamente la aplicación de escritorio para este proyecto. Reinicia para aplicar."

#. Key:	Settingb5ad45ccab
msgctxt "NeoStack.NativePluginSettingsStore,Settingb5ad45ccab"
msgid "Preferred connection port"
msgstr "Puerto de conexión preferido"

#. Key:	Settingcb59426a2a
msgctxt "NeoStack.NativePluginSettingsStore,Settingcb59426a2a"
msgid "NeoStack automatically tries another port if this one is occupied. Existing connections are kept until you restart."
msgstr "Si este puerto está ocupado, NeoStack prueba otro automáticamente. Las conexiones existentes se mantienen hasta reiniciar."

#. Key:	Setting97be97376e
msgctxt "NeoStack.NativePluginSettingsStore,Setting97be97376e"
msgid "Allow browser requests"
msgstr "Permitir solicitudes del navegador"

#. Key:	Settingec3e5543ab
msgctxt "NeoStack.NativePluginSettingsStore,Settingec3e5543ab"
msgid "Allow browser-origin clients to contact this editor. Keep off unless your integration needs it. Applies to new requests."
msgstr "Permitir que clientes de navegador contacten este editor. Déjalo desactivado salvo que la integración lo necesite. Se aplica a solicitudes nuevas."

#. Key:	Settingc25537b20b
msgctxt "NeoStack.NativePluginSettingsStore,Settingc25537b20b"
msgid "Require connection authentication"
msgstr "Exigir autenticación de conexión"

#. Key:	Settingfecc63d1fb
msgctxt "NeoStack.NativePluginSettingsStore,Settingfecc63d1fb"
msgid "Require a token for browser and non-local requests. Trusted non-browser loopback clients are exempt. Applies to new requests."
msgstr "Exigir token para solicitudes de navegador y no locales. Los clientes loopback fiables que no son navegador están exentos. Se aplica a solicitudes nuevas."

#. Key:	Setting65af77083c
msgctxt "NeoStack.NativePluginSettingsStore,Setting65af77083c"
msgid "Allowed tool patterns"
msgstr "Patrones de herramientas permitidas"

#. Key:	Settingc485e49eda
msgctxt "NeoStack.NativePluginSettingsStore,Settingc485e49eda"
msgid "One wildcard pattern per line. Only matching Unreal ToolsetRegistry calls are allowed; blocked patterns take priority. Empty denies all calls."
msgstr "Un patrón comodín por línea. Solo se permiten llamadas Unreal ToolsetRegistry coincidentes; los bloqueos tienen prioridad. Vacío deniega todas las llamadas."

#. Key:	Setting0dc0e56591
msgctxt "NeoStack.NativePluginSettingsStore,Setting0dc0e56591"
msgid "One wildcard pattern per line. Applies to new calls; existing work is not canceled."
msgstr "Un patrón comodín por línea. Se aplica a llamadas nuevas; no se cancela el trabajo existente."

#. Key:	Setting9ac6dfcbbb
msgctxt "NeoStack.NativePluginSettingsStore,Setting9ac6dfcbbb"
msgid "Blocked tool patterns"
msgstr "Patrones de herramientas bloqueadas"

#. Key:	Setting20f7e859ed
msgctxt "NeoStack.NativePluginSettingsStore,Setting20f7e859ed"
msgid "1–300 seconds. Stops waiting, but cannot cancel work already running inside Unreal ToolsetRegistry."
msgstr "1–300 segundos. Deja de esperar, pero no cancela trabajo ya ejecutándose dentro de Unreal ToolsetRegistry."

#. Key:	Setting66e837e09e
msgctxt "NeoStack.NativePluginSettingsStore,Setting66e837e09e"
msgid "Unreal tool wait timeout (seconds)"
msgstr "Tiempo de espera de herramientas Unreal (segundos)"

#. Key:	Setting8d5219c4ee
msgctxt "NeoStack.NativePluginSettingsStore,Setting8d5219c4ee"
msgid "30–1800 seconds for new OpenAI-compatible streaming requests. Does not change ACP agent timeouts."
msgstr "30–1800 segundos para nuevas solicitudes de streaming compatibles con OpenAI. No cambia los tiempos límite de agentes ACP."

#. Key:	Settingb93d741acd
msgctxt "NeoStack.NativePluginSettingsStore,Settingb93d741acd"
msgid "HTTP chat timeout (seconds)"
msgstr "Tiempo de espera del chat HTTP (segundos)"

#. Key:	Setting9f956d07db
msgctxt "NeoStack.NativePluginSettingsStore,Setting9f956d07db"
msgid "Desktop discovery file"
msgstr "Archivo de detección de escritorio"

#. Key:	Settinge8c6a701c1
msgctxt "NeoStack.NativePluginSettingsStore,Settinge8c6a701c1"
msgid "Leave empty for automatic project discovery. Restart to apply."
msgstr "Deja vacío para detectar el proyecto automáticamente. Reinicia para aplicar."

#. Key:	Settingae72f1f174
msgctxt "NeoStack.NativePluginSettingsStore,Settingae72f1f174"
msgid "Agent runtime executable"
msgstr "Ejecutable del entorno del agente"

#. Key:	Settingbfd92a78b7
msgctxt "NeoStack.NativePluginSettingsStore,Settingbfd92a78b7"
msgid "Leave empty for the bundled runtime or NEOSTACK_HOSTD_PATH. Use an absolute path. Restart to apply."
msgstr "Deja vacío para el runtime incluido o NEOSTACK_HOSTD_PATH. Usa una ruta absoluta. Reinicia para aplicar."

#. Key:	Setting53d3e485d5
msgctxt "NeoStack.NativePluginSettingsStore,Setting53d3e485d5"
msgid "Usage reporting endpoint"
msgstr "Endpoint de informes de uso"

#. Key:	Settinge209a413d8
msgctxt "NeoStack.NativePluginSettingsStore,Settinge209a413d8"
msgid "Normally managed by NeoStack. HTTPS is required except on localhost. Leave empty for the default. Restart to apply."
msgstr "Normalmente gestionado por NeoStack. Se requiere HTTPS salvo en localhost. Deja vacío para el valor predeterminado. Reinicia para aplicar."

#. Key:	Setting4253f153d5
msgctxt "NeoStack.NativePluginSettingsStore,Setting4253f153d5"
msgid "Normally managed by NeoStack. An empty endpoint disables full-log uploads. Existing uploads keep their original destination."
msgstr "Normalmente gestionado por NeoStack. Un endpoint vacío desactiva cargas de registros completos. Las cargas existentes conservan su destino original."

#. Key:	Setting824d87c400

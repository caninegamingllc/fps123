msgctxt "NeoStack.IntegrationMetadata,UAFLayering.enablesAgentTo.2"
msgid "Bind a layer stack to an actor's UAF component and verify layer weights in PIE through the skeletal mesh pose"
msgstr "Lier une pile de couches au composant UAF d’un acteur et vérifier les poids dans PIE via la pose du maillage squelettique"

#. Key:	Vegetation.agentSummary
msgctxt "NeoStack.IntegrationMetadata,Vegetation.agentSummary"
msgid "Adds tools for Procedural Vegetation Editor assets in UE 5.8+: inner PCG graph authoring, export-node settings, generation jobs and the editor export command."
msgstr "Ajoute des outils pour les assets Procedural Vegetation Editor dans UE 5.8+ : graphes PCG internes, paramètres des nœuds Export, tâches de génération et commande d’exportation."

#. Key:	Vegetation.whenToEnable
msgctxt "NeoStack.IntegrationMetadata,Vegetation.whenToEnable"
msgid "Your UE 5.8+ project uses the experimental Procedural Vegetation Editor plugin (requires the PCG integration)."
msgstr "Votre projet UE 5.8+ utilise le plugin expérimental Procedural Vegetation Editor (intégration PCG requise)."

#. Key:	Vegetation.enablesAgentTo.0
msgctxt "NeoStack.IntegrationMetadata,Vegetation.enablesAgentTo.0"
msgid "Open ProceduralVegetation assets and edit their embedded PCG graph"
msgstr "Ouvrir des assets ProceduralVegetation et modifier leur graphe PCG intégré"

#. Key:	AudioSynesthesia.enablesAgentTo.2
msgctxt "NeoStack.IntegrationMetadata,AudioSynesthesia.enablesAgentTo.2"
msgid "Attach NRT analyzer assets to settings assets"
msgstr "Joindre des assets d’analyse NRT aux assets de paramètres"

#. Key:	Vegetation.enablesAgentTo.1
msgctxt "NeoStack.IntegrationMetadata,Vegetation.enablesAgentTo.1"
msgid "List, add and configure Export nodes with validated FPVExportParams"
msgstr "Lister, ajouter et configurer des nœuds Export avec des FPVExportParams validés"


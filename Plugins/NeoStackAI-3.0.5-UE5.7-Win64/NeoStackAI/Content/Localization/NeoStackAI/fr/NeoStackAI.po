msgid "Your project uses the experimental Unreal Animation Framework layering plugin (UAFLayering, UE 5.8)."
msgstr "Votre projet utilise le plugin expérimental de couches Unreal Animation Framework (UAFLayering, UE 5.8)."

#. Key:	UAFLayering.enablesAgentTo.0
msgctxt "NeoStack.IntegrationMetadata,UAFLayering.enablesAgentTo.0"
msgid "Create UAF Layer Stack assets and inspect their layers, weights and blend settings"
msgstr "Créer des assets UAF Layer Stack et inspecter leurs couches, poids et paramètres de mélange"


msgctxt "NeoStack.IntegrationMetadata,Vegetation.enablesAgentTo.3"
msgid "Dispatch the editor's Export command from an interactive session"
msgstr "Déclencher la commande Exporter de l’éditeur depuis une session interactive"

#. Key:	VideoEncoding.agentSummary
msgctxt "NeoStack.IntegrationMetadata,VideoEncoding.agentSummary"
msgid "Adds hardware H.264/H.265 video to playtest recordings: playtest_record_start writes an MP4 next to the still track when the GPU encoder is available."
msgstr "Ajoute une vidéo H.264/H.265 matérielle aux enregistrements de playtest : playtest_record_start écrit un MP4 à côté de la piste d'images fixes lorsque l'encodeur GPU est disponible."

#. Key:	VideoEncoding.whenToEnable
msgctxt "NeoStack.IntegrationMetadata,VideoEncoding.whenToEnable"
msgid "You want playtest recordings as video. Also enable the engine codec plugin for your GPU: NVCodecs (NVIDIA), AMFCodecs (AMD) or VTCodecs (Apple)."
msgstr "Vous voulez des enregistrements de playtest en vidéo. Activez aussi le plugin de codec du moteur pour votre GPU : NVCodecs (NVIDIA), AMFCodecs (AMD) ou VTCodecs (Apple)."

#. Key:	VideoEncoding.enablesAgentTo.0
msgctxt "NeoStack.IntegrationMetadata,VideoEncoding.enablesAgentTo.0"
msgid "Record a PIE session to a playable MP4 through NVENC, AMF or VideoToolbox"
msgstr "Enregistrer une session PIE dans un MP4 lisible via NVENC, AMF ou VideoToolbox"


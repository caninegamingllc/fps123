msgid "{Details} {Next}"
msgstr "{Details} {Next}"

#. Key:	Connect2a28e991d1
msgctxt "NeoStack.NativeChatClientConnectSettings,Connect2a28e991d1"
msgid "A previous setup stopped partway through. Recover setup to check and finish its saved changes."
msgstr "Eine frühere Einrichtung wurde unterbrochen. Einrichtung wiederherstellen, um gespeicherte Änderungen zu prüfen und abzuschließen."

#. Key:	Connect6271fd1984
msgctxt "NeoStack.NativeChatClientConnectSettings,Connect6271fd1984"
msgid "Update or reinstall the NeoStack plugin, then check setup again."
msgstr "NeoStack-Plugin aktualisieren oder neu installieren, dann Einrichtung erneut prüfen."

#. Key:	Connect8f4d689910
msgctxt "NeoStack.NativeChatClientConnectSettings,Connect8f4d689910"
msgid "Existing settings were preserved. Resolve the reported conflict, then check setup again."
msgstr "Bestehende Einstellungen wurden erhalten. Gemeldeten Konflikt lösen, dann Einrichtung erneut prüfen."

#. Key:	Connect6c64b4a262
msgctxt "NeoStack.NativeChatClientConnectSettings,Connect6c64b4a262"
msgid "Prepare NeoStack's tools for this project. Codex keeps control of project trust and sign-in prompts."
msgstr "NeoStacks Werkzeuge für dieses Projekt vorbereiten. Codex behält die Kontrolle über Projektvertrauen und Anmeldeabfragen."

#. Key:	Connectb955839ceb
msgctxt "NeoStack.NativeChatClientConnectSettings,Connectb955839ceb"
msgid "Prepare a local NeoStack plugin for this Antigravity app workspace. The app keeps control of sign-in and tool permissions."
msgstr "Ein lokales NeoStack-Plugin für diesen Antigravity-App-Arbeitsbereich vorbereiten. Die App behält Kontrolle über Anmeldung und Werkzeugrechte."

#. Key:	Connect717924dd03
msgctxt "NeoStack.NativeChatClientConnectSettings,Connect717924dd03"
msgid "Prepare NeoStack's tools for this Antigravity CLI workspace. Antigravity keeps control of sign-in and tool permissions."
msgstr "NeoStacks Werkzeuge für diesen Antigravity-CLI-Arbeitsbereich vorbereiten. Antigravity behält Kontrolle über Anmeldung und Werkzeugrechte."

#. Key:	Connecta50fc3caa9
msgctxt "NeoStack.NativeChatClientConnectSettings,Connecta50fc3caa9"
msgid "Prepare tools for this Git repository, then open it in Copilot and trust it if prompted."
msgstr "Werkzeuge für dieses Git-Repository vorbereiten, dann in Copilot öffnen und bei Nachfrage vertrauen."

#. Key:	Connectee12a878be
msgctxt "NeoStack.NativeChatClientConnectSettings,Connectee12a878be"
msgid "Connect prepares NeoStack's tools. Claude keeps control of its trust and sign-in prompts."
msgstr "„Verbinden“ bereitet NeoStacks Werkzeuge vor. Claude behält die Kontrolle über Vertrauens- und Anmeldeabfragen."

#. Key:	LocateAppNext
msgctxt "NeoStack.NativeChatClientConnectSettings,LocateAppNext"
msgid "{Next} Locate or install the selected app, then open this project there. You can prepare the project files first."
msgstr "{Next} Ausgewählte App suchen oder installieren, dann dieses Projekt dort öffnen. Projektdateien können zuerst vorbereitet werden."


                "Text": "Include beta releases"
              },
              "Key": "Settingc1b23c6508"
            },
            {
              "Source": {
                "Text": "Leave empty for automatic project discovery. Restart to apply."
              },
              "Translation": {
                "Text": "Leave empty for automatic project discovery. Restart to apply."
              },
              "Key": "Settinge8c6a701c1"
            },
            {
              "Source": {
                "Text": "Leave empty for the bundled runtime or NEOSTACK_HOSTD_PATH. Use an absolute path. Restart to apply."
              },
              "Translation": {
                "Text": "Leave empty for the bundled runtime or NEOSTACK_HOSTD_PATH. Use an absolute path. Restart to apply."
              },
              "Key": "Settingbfd92a78b7"
            },
            {
              "Source": {
                "Text": "NeoStack automatically tries another port if this one is occupied. Existing connections are kept until you restart."
              },
              "Translation": {
                "Text": "NeoStack automatically tries another port if this one is occupied. Existing connections are kept until you restart."
              },
              "Key": "Settingcb59426a2a"
            },
            {
              "Source": {
                "Text": "Normally managed by NeoStack. An empty endpoint disables full-log uploads. Existing uploads keep their original destination."
              },
              "Translation": {
                "Text": "Normally managed by NeoStack. An empty endpoint disables full-log uploads. Existing uploads keep their original destination."
              },
              "Key": "Setting4253f153d5"
            },
            {
              "Source": {
                "Text": "Normally managed by NeoStack. HTTPS is required except on localhost. Leave empty for the default. Restart to apply."
              },
              "Translation": {
                "Text": "Normally managed by NeoStack. HTTPS is required except on localhost. Leave empty for the default. Restart to apply."
              },
              "Key": "Settinge209a413d8"
            },
            {
              "Source": {
                "Text": "Offer preview builds as well as stable releases. Applies to the next update check."
              },
              "Translation": {
                "Text": "Offer preview builds as well as stable releases. Applies to the next update check."
              },
              "Key": "Settingf4b5331272"
            },
            {
              "Source": {
                "Text": "One wildcard pattern per line. Applies to new calls; existing work is not canceled."
              },
              "Translation": {
                "Text": "One wildcard pattern per line. Applies to new calls; existing work is not canceled."
              },
              "Key": "Setting0dc0e56591"
            },
            {
              "Source": {
                "Text": "One wildcard pattern per line. Only matching Unreal ToolsetRegistry calls are allowed; blocked patterns take priority. Empty denies all calls."
              },
              "Translation": {
                "Text": "One wildcard pattern per line. Only matching Unreal ToolsetRegistry calls are allowed; blocked patterns take priority. Empty denies all calls."
              },
              "Key": "Settingc485e49eda"
            },
            {
              "Source": {
                "Text": "Optional usage analytics"
              },
              "Translation": {
                "Text": "Optional usage analytics"
              },
              "Key": "Setting114cdf5408"
            },
            {
              "Source": {
                "Text": "Plugin settings exceed the supported 1 MiB limit."
              },
              "Translation": {
                "Text": "Plugin settings exceed the supported 1 MiB limit."
              },
              "Key": "PluginSettingsExceedTheSupported1MibLimitca0bbb"
            },
            {
              "Source": {
                "Text": "Preferred connection port"
              },
              "Translation": {
                "Text": "Preferred connection port"
              },
              "Key": "Settingb5ad45ccab"
            },
            {
              "Source": {
                "Text": "Privacy & reports"
              },
              "Translation": {
                "Text": "Privacy & reports"
              },
              "Key": "Setting48c6612200"
            },
            {
              "Source": {
                "Text": "Report services"
              },
              "Translation": {
                "Text": "Report services"
              },
              "Key": "Setting5ab887d982"
            },
            {
              "Source": {
                "Text": "Require a token for browser and non-local requests. Trusted non-browser loopback clients are exempt. Applies to new requests."
              },
              "Translation": {
                "Text": "Require a token for browser and non-local requests. Trusted non-browser loopback clients are exempt. Applies to new requests."
              },
              "Key": "Settingfecc63d1fb"
            },
            {
              "Source": {
                "Text": "Require connection authentication"
              },
              "Translation": {
                "Text": "Require connection authentication"
              },
              "Key": "Settingc25537b20b"
            },
            {
              "Source": {
                "Text": "Share basic crash metadata when usage analytics is enabled. Full logs always require review and an explicit send."
              },
              "Translation": {
                "Text": "Share basic crash metadata when usage analytics is enabled. Full logs always require review and an explicit send."
              },
              "Key": "Settingc151e33fda"
            },
            {
              "Source": {
                "Text": "Share product usage events. Turning this off also stops automatic crash reports."
              },
              "Translation": {
                "Text": "Share product usage events. Turning this off also stops automatic crash reports."
              },
              "Key": "Settinge1d12c7004"
            },
            {
              "Source": {
                "Text": "This setting changed in another editor. Reopen this page to reload it before saving."
              },
              "Translation": {
                "Text": "This setting changed in another editor. Reopen this page to reload it before saving."
              },
              "Key": "ThisSettingChangedInAnotherEditorReopenThisPageToReloadIcde467"
            },
            {
              "Source": {
                "Text": "This setting is unavailable."
              },
              "Translation": {
                "Text": "This setting is unavailable."
              },
              "Key": "ThisSettingIsUnavailable952e35"
            },
            {
              "Source": {
                "Text": "This value is too long or contains an invalid character."
              },
              "Translation": {
                "Text": "This value is too long or contains an invalid character."
              },
              "Key": "ThisValueIsTooLongOrContainsAnInvalidCharactera98f91"
            },
            {
              "Source": {
                "Text": "Timeouts"
              },
              "Translation": {
                "Text": "Timeouts"
              },
              "Key": "Setting27a4f2c5a6"
            },
            {
              "Source": {
                "Text": "Unreal tool permissions"
              },
              "Translation": {
                "Text": "Unreal tool permissions"
              },
              "Key": "Setting7c5f25414a"
            },
            {
              "Source": {
                "Text": "Unreal tool wait timeout (seconds)"
              },
              "Translation": {
                "Text": "Unreal tool wait timeout (seconds)"
              },
              "Key": "Setting66e837e09e"
            },
            {
              "Source": {
                "Text": "Updates"
              },
              "Translation": {
                "Text": "Updates"
              },
              "Key": "Settingc76d18079a"
            },
            {
              "Source": {
                "Text": "Usage reporting endpoint"
              },
              "Translation": {
                "Text": "Usage reporting endpoint"
              },
              "Key": "Setting53d3e485d5"
            },
            {
              "Source": {
                "Text": "Use HTTPS, or an HTTP localhost endpoint for development. Embedded credentials are not supported."
              },
              "Translation": {
                "Text": "Use HTTPS, or an HTTP localhost endpoint for development. Embedded credentials are not supported."
              },
              "Key": "UseHttpsOrAnHttpLocalhostEndpointForDevelopmentEmbeddedC2c457c"
            },
            {
              "Source": {
                "Text": "Use an absolute path, or leave empty for automatic discovery."
              },
              "Translation": {
                "Text": "Use an absolute path, or leave empty for automatic discovery."
              },
              "Key": "UseAnAbsolutePathOrLeaveEmptyForAutomaticDiscoverye0c37b"
            },
            {
              "Source": {
                "Text": "Use at most 128 patterns, each up to 256 characters."
              },
              "Translation": {
                "Text": "Use at most 128 patterns, each up to 256 characters."
              },
              "Key": "UseAtMost128PatternsEachUpTo256Characters646a4a"
            }
          ]
        },

            "Text": "Stop remote control"
          },
          "Translation": {
            "Text": "Stop remote control"
          },
          "Key": "Remote"
        },
        {
          "Source": {
            "Text": "The background action could not finish. Please try again."
          },
          "Translation": {
            "Text": "The background action could not finish. Please try again."
          },
          "Key": "TheBackgroundActionCouldNotFinishPleaseTryAgain82fcf1"
        },
        {
          "Source": {
            "Text": "The chat is closed, but its local saved copy could not be removed. Retry deletion when local history is available."
          },
          "Translation": {
            "Text": "The chat is closed, but its local saved copy could not be removed. Retry deletion when local history is available."
          },
          "Key": "TheChatIsClosedButItsLocalSavedCopyCouldNotBeRemovedRetr8b4ac8"
        },
        {
          "Source": {
            "Text": "The chat name could not be saved. The chat may have been deleted, or local history may be unavailable."
          },
          "Translation": {
            "Text": "The chat name could not be saved. The chat may have been deleted, or local history may be unavailable."
          },
          "Key": "TheChatNameCouldNotBeSavedTheChatMayHaveBeenDeletedOrLoc1c78f8"
        },
        {
          "Source": {
            "Text": "The complete history took too long to read. Nothing was exported; try again."
          },
          "Translation": {
            "Text": "The complete history took too long to read. Nothing was exported; try again."
          },
          "Key": "Dialogf916a15909"
        },
        {
          "Source": {
            "Text": "The full chat export finished before cancellation. The saved files are available."
          },
          "Translation": {
            "Text": "The full chat export finished before cancellation. The saved files are available."
          },
          "Key": "Dialog8820e617e1"
        },
        {
          "Source": {
            "Text": "The history cursor did not advance. No incomplete export was published."
          },
          "Translation": {
            "Text": "The history cursor did not advance. No incomplete export was published."
          },
          "Key": "Dialog11f3de4593"
        },
        {
          "Source": {
            "Text": "The terminal could not be opened. You can still copy this command."
          },
          "Translation": {
            "Text": "The terminal could not be opened. You can still copy this command."
          },
          "Key": "TerminalUnavailable"
        },
        {
          "Source": {
            "Text": "This chat changed during export. Wait for the response to finish and try again."
          },
          "Translation": {
            "Text": "This chat changed during export. Wait for the response to finish and try again."
          },
          "Key": "Dialogce9b589d02"
        },
        {
          "Source": {
            "Text": "This chat closed before export finished."
          },
          "Translation": {
            "Text": "This chat closed before export finished."
          },
          "Key": "Dialogb60db78063"
        },
        {
          "Source": {
            "Text": "This chat is no longer available. Refresh the chat list and try again."
          },
          "Translation": {
            "Text": "This chat is no longer available. Refresh the chat list and try again."
          },
          "Key": "ThisChatIsNoLongerAvailableRefreshTheChatListAndTryAgain866509"
        },
        {
          "Source": {
            "Text": "This chat is not currently controlled remotely."
          },
          "Translation": {
            "Text": "This chat is not currently controlled remotely."
          },
          "Key": "Dialoge91d78421a"
        },
        {
          "Source": {
            "Text": "This chat provider does not have a terminal resume command."
          },
          "Translation": {
            "Text": "This chat provider does not have a terminal resume command."
          },
          "Key": "Dialog08a73c5af8"
        },
        {
          "Source": {
            "Text": "Wait for this response or history load to finish, then export the complete chat."
          },
          "Translation": {
            "Text": "Wait for this response or history load to finish, then export the complete chat."
          },
          "Key": "Dialog913aa9b1a8"
        },

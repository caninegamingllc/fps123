#. Key:	DMXControlConsole.domainLabel
msgctxt "NeoStack.IntegrationMetadata,DMXControlConsole.domainLabel"
msgid "DMX"
msgstr "DMX"

#. Key:	DMXControlConsole.agentSummary
msgctxt "NeoStack.IntegrationMetadata,DMXControlConsole.agentSummary"
msgid "Author DMX Control Console assets, raw faders, cue stacks, and console actors from Lua."
msgstr "Lua로 DMX Control Console 에셋, 원시 페이더, 큐 스택 및 콘솔 액터를 작성합니다."

#. Key:	DMXControlConsole.whenToEnable
msgctxt "NeoStack.IntegrationMetadata,DMXControlConsole.whenToEnable"
msgid "Enable when a project uses the engine DMX Control Console plugin for manual DMX fader/cue authoring."
msgstr "프로젝트에서 엔진 DMX Control Console 플러그인으로 DMX 페이더/큐를 수동 작성할 때 활성화하세요."

#. Key:	DMXControlConsole.enablesAgentTo.0
msgctxt "NeoStack.IntegrationMetadata,DMXControlConsole.enablesAgentTo.0"
msgid "Create and inspect control-console rows, fader groups, and raw faders"
msgstr "컨트롤 콘솔 행, 페이더 그룹 및 원시 페이더 생성 및 검사"

#. Key:	ActorModifier.enablesAgentTo.0
msgctxt "NeoStack.IntegrationMetadata,ActorModifier.enablesAgentTo.0"

msgid "AI and gameplay data"
msgstr "AI 및 게임플레이 데이터"

#. Key:	DataRegistry.agentSummary
msgctxt "NeoStack.IntegrationMetadata,DataRegistry.agentSummary"
msgid "Adds authoring support for UE Data Registry assets and table-backed registry sources."
msgstr "UE Data Registry 에셋 및 테이블 기반 레지스트리 소스 작성 지원을 추가합니다."

#. Key:	DataRegistry.whenToEnable
msgctxt "NeoStack.IntegrationMetadata,DataRegistry.whenToEnable"

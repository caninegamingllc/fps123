#. Key:	ACPAgentSettingsEntry
msgctxt "UObjectDisplayNames,ACPAgentSettingsEntry"
msgid "ACPAgent Settings Entry"
msgstr "ACP 智能体设置项"

#. Key:	ACPAgentSettingsEntry
msgctxt "UObjectToolTips,ACPAgentSettingsEntry"
msgid "Agent configuration stored in settings"
msgstr "保存在设置中的智能体配置"

#. Key:	ACPAgentSettingsEntry:AgentName
msgctxt "UObjectDisplayNames,ACPAgentSettingsEntry:AgentName"
msgid "Agent Name"
msgstr "智能体名称"

#. Key:	ACPAgentSettingsEntry:ApiKey
msgctxt "UObjectDisplayNames,ACPAgentSettingsEntry:ApiKey"
msgid "API Key (stored only)"
msgstr "API 密钥（仅存储）"

#. Key:	ACPAgentSettingsEntry:ApiKey
msgctxt "UObjectToolTips,ACPAgentSettingsEntry:ApiKey"
msgid "Not sent by the shared runtime. Use the adapter's documented environment variables or its own login flow."
msgstr "共享运行时不会发送此项。请使用适配器记录的环境变量或其自身的登录流程。"

#. Key:	ACPAgentSettingsEntry:Arguments
msgctxt "UObjectDisplayNames,ACPAgentSettingsEntry:Arguments"
msgid "Arguments"
msgstr "参数"

#. Key:	ACPAgentSettingsEntry:EnvironmentVariables
msgctxt "UObjectDisplayNames,ACPAgentSettingsEntry:EnvironmentVariables"
msgid "Environment Variables"
msgstr "环境变量"

#. Key:	ACPAgentSettingsEntry:ExecutablePath
msgctxt "UObjectDisplayNames,ACPAgentSettingsEntry:ExecutablePath"
msgid "Executable Path"
msgstr "可执行文件路径"

#. Key:	ACPAgentSettingsEntry:ModelId
msgctxt "UObjectDisplayNames,ACPAgentSettingsEntry:ModelId"
msgid "Model ID (stored only)"
msgstr "模型 ID（仅存储）"

#. Key:	ACPAgentSettingsEntry:ModelId
msgctxt "UObjectToolTips,ACPAgentSettingsEntry:ModelId"
msgid "Not applied by the shared runtime. Choose an advertised model in the live chat composer."
msgstr "共享运行时不会应用此项。请在实时聊天编辑器中选择提供的模型。"

#. Key:	ACPAgentSettingsEntry:WorkingDirectory
msgctxt "UObjectDisplayNames,ACPAgentSettingsEntry:WorkingDirectory"
msgid "Working Directory (stored only)"
msgstr "工作目录（仅存储）"

#. Key:	ACPAgentSettingsEntry:WorkingDirectory
msgctxt "UObjectToolTips,ACPAgentSettingsEntry:WorkingDirectory"
msgid "Preserved for compatibility. The shared runtime currently starts chats in the Unreal project directory; this value is not applied."
msgstr "为兼容性保留。共享运行时目前在 Unreal 项目目录中启动聊天；此值不会被应用。"

#. Key:	ACPCustomAgentDraft
msgctxt "UObjectDisplayNames,ACPCustomAgentDraft"
msgid "ACPCustom Agent Draft"
msgstr "ACP 自定义智能体草稿"

#. Key:	ACPCustomAgentDraft
msgctxt "UObjectToolTips,ACPCustomAgentDraft"
msgid "Detached property-editor data. Editing this struct never edits the settings CDO."
msgstr "独立的属性编辑器数据。编辑此结构体不会修改设置 CDO。"

#. Key:	ACPCustomAgentDraft:AgentPathOverrides
msgctxt "UObjectDisplayNames,ACPCustomAgentDraft:AgentPathOverrides"
msgid "Registry ID to ACP executable"
msgstr "注册表 ID 到 ACP 可执行文件的映射"

#. Key:	ACPCustomAgentDraft:AgentPathOverrides
msgctxt "UObjectToolTips,ACPCustomAgentDraft:AgentPathOverrides"
msgid "For extra registry agents only. Managed claude-acp and codex-acp overrides are unsupported. Missing files use the registry distribution."
msgstr "仅适用于额外的注册表智能体。不支持覆盖托管的 claude-acp 和 codex-acp。文件缺失时使用注册表发行版。"

#. Key:	ACPCustomAgentDraft:CustomAgents
msgctxt "UObjectDisplayNames,ACPCustomAgentDraft:CustomAgents"
msgid "Custom Agents"
msgstr "自定义智能体"

#. Key:	Error6ea6f4b280
msgctxt "NeoStack.ImageRead,Error6ea6f4b280"
msgid "This message is no longer available in the active chat."
msgstr "此消息在当前聊天中已不可用。"

#. Key:	Error41939e006e
msgctxt "NeoStack.ImageRead,Error41939e006e"
msgid "This recorded image is no longer available."
msgstr "此记录的图像已不可用。"

#. Key:	Errorc995cb7c00
msgctxt "NeoStack.ImageRead,Errorc995cb7c00"
msgid "This image no longer matches its recorded attachment identity."
msgstr "此图像不再与其记录的附件标识匹配。"

#. Key:	Error4652d574c6
msgctxt "NeoStack.ImageRead,Error4652d574c6"
msgid "This image is still being prepared. Open Images again shortly."
msgstr "此图像仍在准备中。请稍后重新打开“图像”。"

#. Key:	Error56ec67e3eb
msgctxt "NeoStack.ImageRead,Error56ec67e3eb"
msgid "This image exceeds the bounded preview size."
msgstr "此图像超出预览大小限制。"

#. Key:	Errord739f5cb60
msgctxt "NeoStack.ImageRead,Errord739f5cb60"
msgid "The original image bytes are no longer in this chat, and no saved copy is recorded. To use an image again, attach it in a new message."
msgstr "原始图像数据已不在此聊天中，也没有记录已保存的副本。如需再次使用图像，请将其附加到新消息中。"

#. Key:	Error6254a9bf00
msgctxt "NeoStack.ImageRead,Error6254a9bf00"
msgid "This recorded image has no available preview data."
msgstr "此记录的图像没有可用的预览数据。"

#. Key:	Error92529dc1c4
msgctxt "NeoStack.ImageRead,Error92529dc1c4"
msgid "The chat changed while reading this image. Open the image again."
msgstr "读取此图像时聊天发生更改。请重新打开图像。"

#. Key:	Error3617e5ae28
msgctxt "NeoStack.ImageRead,Error3617e5ae28"
msgid "The tool result changed while reading this image. Open the image again."
msgstr "读取此图像时工具结果发生更改。请重新打开图像。"

#. Key:	Errora92cb3c3c0
msgctxt "NeoStack.ImageRead,Errora92cb3c3c0"
msgid "The recorded image identity changed. Open the image again."
msgstr "记录的图像标识已更改。请重新打开图像。"

#. Key:	Error0ef55b2bbe
msgctxt "NeoStack.ImageRead,Error0ef55b2bbe"
msgid "The image data changed while it was being read."
msgstr "图像数据在读取期间发生更改。"

#. Key:	Message45801aeb56
msgctxt "NeoStack.ClientConnectionInstall,Message45801aeb56"
msgid "The connection journal is unreadable or does not match this project. No configuration was changed."
msgstr "连接日志不可读或与此项目不匹配。配置未更改。"

#. Key:	Messaged525ce7143
msgctxt "NeoStack.ClientConnectionInstall,Messaged525ce7143"
msgid "Registration changed, but its ownership journal still needs reconciliation."
msgstr "注册信息已更改，但其所有权日志仍需协调恢复。"

#. Key:	Messagef3786ef439
msgctxt "NeoStack.ClientConnectionInstall,Messagef3786ef439"
msgid "Plugin registration changed, but its marker or folder changed. Recovery preserved the existing files."
msgstr "插件注册信息已更改，但其标记或文件夹也已更改。恢复操作保留了现有文件。"

#. Key:	Message1a1413cef7
msgctxt "NeoStack.ClientConnectionInstall,Message1a1413cef7"
msgid "Registration is committed; ownership recording is still pending. Reconcile before another change."
msgstr "注册信息已提交；所有权记录仍待处理。请先协调恢复再进行其他更改。"

#. Key:	Messageddfc632056
msgctxt "NeoStack.ClientConnectionInstall,Messageddfc632056"
msgid "Registration is committed; journal cleanup is still pending. Reconcile before another change."
msgstr "注册信息已提交；日志清理仍待处理。请先协调恢复再进行其他更改。"

#. Key:	Messageca3f0d38b5
msgctxt "NeoStack.ClientConnectionInstall,Messageca3f0d38b5"
msgid "An interrupted preparation needs reconciliation. The recorded registration is unchanged."
msgstr "中断的准备工作需要协调恢复。已记录的注册信息未更改。"

#. Key:	Message8f9564de54
msgctxt "NeoStack.ClientConnectionInstall,Message8f9564de54"
msgid "The interrupted preparation could not be cleaned up safely."
msgstr "无法安全清理中断的准备工作。"

#. Key:	Message7bd61499ec
msgctxt "NeoStack.ClientConnectionInstall,Message7bd61499ec"
msgid "Connection files changed during an interrupted operation. Reconciliation cannot take ownership of those edits."
msgstr "连接文件在中断的操作期间发生更改。协调恢复无法取得这些编辑的所有权。"

#. Key:	Message13543eaf1d
msgctxt "NeoStack.ClientConnectionInstall,Message13543eaf1d"
msgid "Connection inputs exceed their supported limits."
msgstr "连接输入超出支持的限制。"

#. Key:	Messageb2a7843083
msgctxt "NeoStack.ClientConnectionInstall,Messageb2a7843083"
msgid "This connection requires accessible local project and artifact paths without links or reparse traversal."
msgstr "此连接需要可访问的本地项目和产物路径，且不能经过链接或重解析点。"

#. Key:	Message833c2040ca
msgctxt "NeoStack.ClientConnectionInstall,Message833c2040ca"
msgid "Connection target paths are linked, unreadable or otherwise unsupported. No configuration was changed."
msgstr "连接目标路径是链接、不可读或不受支持。配置未更改。"

#. Key:	Message2381388d69
msgctxt "NeoStack.ClientConnectionInstall,Message2381388d69"
msgid "Connection preparation cancelled. No registration was changed."
msgstr "已取消连接准备。注册信息未更改。"

#. Key:	Message28fc88b21e
msgctxt "NeoStack.ClientConnectionInstall,Message28fc88b21e"
msgid "The admitted Windows connector artifact is missing or invalid. No registration was changed."
msgstr "已准入的 Windows 连接器产物缺失或无效。注册信息未更改。"

#. Key:	Message58f76c2152
msgctxt "NeoStack.ClientConnectionInstall,Message58f76c2152"
msgid "Another connection operation owns this project, or its ownership directory is unavailable. Try again after it finishes."
msgstr "另一个连接操作占用了此项目，或其所有权目录不可用。请待操作完成后重试。"

#. Key:	Message7a0ae5a951
msgctxt "NeoStack.ClientConnectionInstall,Message7a0ae5a951"
msgid "Project .codex/config.toml is unreadable or uses malformed, duplicated or unsupported TOML syntax. It was preserved."
msgstr "项目 .codex/config.toml 不可读，或使用了格式错误、重复或不受支持的 TOML 语法。已保留该文件。"

#. Key:	Message3ad502873f
msgctxt "NeoStack.ClientConnectionInstall,Message3ad502873f"
msgid "The local plugin MCP file was preserved. This setup requires strict JSON containing only its owned neostack server. Other plugin content needs separate review."
msgstr "已保留本地插件 MCP 文件。此设置要求严格 JSON，且仅包含其受管理的 neostack 服务器。其他插件内容需要单独审查。"

#. Key:	Message077a80597c
msgctxt "NeoStack.ClientConnectionInstall,Message077a80597c"
msgid "Project .agents/mcp_config.json was preserved. Setup requires readable, bounded strict JSON without duplicate keys. Antigravity supports JSONC, but this writer preserves and refuses comments and trailing commas; use its MCP manager for that configuration."
msgstr "已保留项目 .agents/mcp_config.json。设置要求可读、大小受限且无重复键的严格 JSON。Antigravity 支持 JSONC，但此写入器会保留并拒绝修改带注释和尾随逗号的内容；请使用其 MCP 管理器处理此类配置。"

#. Key:	Message575a3528e0
msgctxt "NeoStack.ClientConnectionInstall,Message575a3528e0"
msgid "Project .mcp.json is unreadable, malformed, duplicated or outside the supported JSON limits. It was preserved."
msgstr "项目 .mcp.json 不可读、格式错误、存在重复项或超出支持的 JSON 限制。已保留该文件。"

#. Key:	Message51f6c28c68
msgctxt "NeoStack.ClientConnectionInstall,Message51f6c28c68"
msgid "This .mcp.json uses a bare server map. Shared setup requires a mcpServers object; adding one here could hide your existing servers. Keep this configuration or convert the whole map to that format, then Check setup."
msgstr "此 .mcp.json 直接使用服务器映射。共享设置需要 mcpServers 对象；在此添加该对象可能会隐藏现有服务器。请保留此配置，或将整个映射转换为该格式后再检查设置。"

#. Key:	Messaged1d8d56687
msgctxt "NeoStack.ClientConnectionInstall,Messaged1d8d56687"
msgid "The connection ownership receipt is invalid or belongs to another project/artifact location. It was preserved."
msgstr "连接所有权凭据无效或属于其他项目/产物位置。已保留该凭据。"

#. Key:	Message65360898bd
msgctxt "NeoStack.ClientConnectionInstall,Message65360898bd"
msgid "The local neostack plugin contains an unowned or changed marker, or additional files. Existing plugin content was preserved."
msgstr "本地 neostack 插件包含不受管理或已更改的标记，或其他文件。已保留现有插件内容。"

#. Key:	Messaged3a5a3349f
msgctxt "NeoStack.ClientConnectionInstall,Messaged3a5a3349f"
msgid "The neostack entry is unowned or was edited outside this connection. It will not be replaced or removed."
msgstr "neostack 条目不受管理或已在此连接之外编辑。不会替换或移除它。"

#. Key:	Message9fba0ee041
msgctxt "NeoStack.ClientConnectionInstall,Message9fba0ee041"
msgid "Project setup is prepared. Check the connection in your app."
msgstr "项目设置已准备好。请在应用中检查连接。"

#. Key:	Messagea84642bbaa
msgctxt "NeoStack.ClientConnectionInstall,Messagea84642bbaa"
msgid "The owned registration remains, but its cached connector is missing or changed."
msgstr "受管理的注册信息仍在，但缓存的连接器缺失或已更改。"

#. Key:	Messagef58582219b
msgctxt "NeoStack.ClientConnectionInstall,Messagef58582219b"
msgid "No owned project registration is present for this client."
msgstr "此客户端没有受管理的项目注册信息。"

#. Key:	Message4750f83e80
msgctxt "NeoStack.ClientConnectionInstall,Message4750f83e80"
msgid "No owned entry needs removal. Cached connector versions are retained."
msgstr "没有需要移除的受管理条目。已保留缓存的连接器版本。"

#. Key:	Messaged3c1c742ac
msgctxt "NeoStack.ClientConnectionInstall,Messaged3c1c742ac"
msgid "Another Antigravity workspace route is present or cannot be checked safely. Keep that setup, or remove its owned connection before preparing this route. Existing settings were preserved."
msgstr "存在另一个 Antigravity 工作区连接路径，或无法安全检查。请保留该设置，或先移除其受管理连接再准备此路径。已保留现有设置。"

#. Key:	Message6459463c05
msgctxt "NeoStack.ClientConnectionInstall,Message6459463c05"
msgid "The immutable connector could not be prepared and verified. Project registration was preserved."
msgstr "无法准备并验证不可变连接器。已保留项目注册信息。"

#. Key:	Message4ca99e4717
msgctxt "NeoStack.ClientConnectionInstall,Message4ca99e4717"
msgid "Connector prepared; registration has not changed."
msgstr "连接器已准备好；注册信息未更改。"

#. Key:	Message34d02112cf
msgctxt "NeoStack.ClientConnectionInstall,Message34d02112cf"
msgid "The exact owned registration and connector are already present. No sign-in or host reload was started."
msgstr "完全匹配的受管理注册信息和连接器已存在。未启动登录或主机重新加载。"

#. Key:	Message24aebe83d8
msgctxt "NeoStack.ClientConnectionInstall,Message24aebe83d8"
msgid "Preparation cancelled before registration. Immutable cached connector bytes were retained."
msgstr "已在注册前取消准备。已保留不可变的连接器缓存数据。"

#. Key:	Messagefdf20d4438
msgctxt "NeoStack.ClientConnectionInstall,Messagefdf20d4438"
msgid "The project configuration could not be changed within the supported limits. It was preserved."
msgstr "无法在支持的限制内更改项目配置。已保留配置。"

#. Key:	Message59b80730b7
msgctxt "NeoStack.ClientConnectionInstall,Message59b80730b7"
msgid "The project configuration directory could not be prepared safely."
msgstr "无法安全准备项目配置目录。"

#. Key:	Message2ddaba50d8
msgctxt "NeoStack.ClientConnectionInstall,Message2ddaba50d8"
msgid "The replacement could not be prepared and read back. Project registration was preserved."
msgstr "无法准备替换内容并回读。已保留项目注册信息。"

#. Key:	Message9127b65427
msgctxt "NeoStack.ClientConnectionInstall,Message9127b65427"
msgid "The recovery journal could not be recorded. Project registration was preserved."
msgstr "无法记录恢复日志。已保留项目注册信息。"

#. Key:	Messagefd5bad707a
msgctxt "NeoStack.ClientConnectionInstall,Messagefd5bad707a"
msgid "Preparation was interrupted before replacement. Reconcile the journal before another change."
msgstr "准备工作在替换前中断。请先协调恢复日志再进行其他更改。"

#. Key:	Message31a9c2e6d1
msgctxt "NeoStack.ClientConnectionInstall,Message31a9c2e6d1"
msgid "Cancelled before registration replacement. Reconcile if staged ownership cleanup remains."
msgstr "已在替换注册信息前取消。如果暂存的所有权清理尚未完成，请进行协调恢复。"

#. Key:	Messaged9e7566ba2
msgctxt "NeoStack.ClientConnectionInstall,Messaged9e7566ba2"
msgid "Connection files changed or became read-only after preparation. The current project file was preserved; retry from a fresh observation."
msgstr "连接文件在准备后发生更改或变为只读。已保留当前项目文件；请重新检查状态后重试。"

#. Key:	Messageeae9b724b3
msgctxt "NeoStack.ClientConnectionInstall,Messageeae9b724b3"
msgid "Cancelled before registration replacement."
msgstr "已在替换注册信息前取消。"

#. Key:	Message664c60a15f
msgctxt "NeoStack.ClientConnectionInstall,Message664c60a15f"
msgid "The project file could not be replaced. Its previous registration was preserved."
msgstr "无法替换项目文件。已保留其先前的注册信息。"

#. Key:	Messagea78f0ac2e4
msgctxt "NeoStack.ClientConnectionInstall,Messagea78f0ac2e4"
msgid "Registration committed; ownership recording was interrupted. Reconcile before another change."
msgstr "注册信息已提交；所有权记录已中断。请先协调恢复再进行其他更改。"

#. Key:	Messagee1db6f74e3
msgctxt "NeoStack.ClientConnectionInstall,Messagee1db6f74e3"
msgid "Registration was replaced but its readback or ownership changed. The journal was kept for reconciliation."
msgstr "注册信息已替换，但其回读内容或所有权已更改。已保留日志以供协调恢复。"

#. Key:	Message6e30c6394f
msgctxt "NeoStack.ClientConnectionInstall,Message6e30c6394f"
msgid "MCP entry committed; plugin activation is pending recovery."
msgstr "MCP 条目已提交；插件激活等待恢复。"

#. Key:	Message6ff67c0d2e
msgctxt "NeoStack.ClientConnectionInstall,Message6ff67c0d2e"
msgid "Plugin activation or ownership recording needs recovery. Existing changes were kept."
msgstr "插件激活或所有权记录需要恢复。已保留现有更改。"

#. Key:	Message9e35d28e73
msgctxt "NeoStack.ClientConnectionInstall,Message9e35d28e73"
msgid "Plugin files changed after activation. Their ownership journal was kept for recovery."
msgstr "插件文件在激活后发生更改。已保留其所有权日志以供恢复。"

#. Key:	Message019d1acd67
msgctxt "NeoStack.ClientConnectionInstall,Message019d1acd67"
msgid "Registration committed; its ownership receipt is still pending."
msgstr "注册信息已提交；其所有权凭据仍待处理。"

#. Key:	Messagec7056318e1
msgctxt "NeoStack.ClientConnectionInstall,Messagec7056318e1"
msgid "Registration committed, but the ownership receipt could not be written. Reconcile before another change."
msgstr "注册信息已提交，但无法写入所有权凭据。请先协调恢复再进行其他更改。"

#. Key:	Messagee0b5125a92
msgctxt "NeoStack.ClientConnectionInstall,Messagee0b5125a92"
msgid "Registration committed, but ownership readback failed. The recovery journal was retained."
msgstr "注册信息已提交，但所有权回读失败。已保留恢复日志。"

#. Key:	Message405f4fb26c
msgctxt "NeoStack.ClientConnectionInstall,Message405f4fb26c"
msgid "Registration and ownership committed; journal cleanup still needs reconciliation."
msgstr "注册信息和所有权已提交；日志清理仍需协调恢复。"

#. Key:	Message95e723cd71
msgctxt "NeoStack.ClientConnectionInstall,Message95e723cd71"
msgid "Codex project registration saved. Open and trust this project in Codex, then restart or reload it; actual client loading is not verified."
msgstr "已保存 Codex 项目注册信息。请在 Codex 中打开并信任此项目，然后重启或重新加载；尚未验证客户端实际加载情况。"

#. Key:	Message157bfd8f31
msgctxt "NeoStack.ClientConnectionInstall,Message157bfd8f31"
msgid "Antigravity local plugin saved. Open this project as the app workspace, reload and approve its tools; actual client loading is not verified."
msgstr "已保存 Antigravity 本地插件。请将此项目作为应用工作区打开，重新加载并批准其工具；尚未验证客户端实际加载情况。"

#. Key:	Message6e7da10716
msgctxt "NeoStack.ClientConnectionInstall,Message6e7da10716"
msgid "Antigravity workspace registration saved. Open this project in Antigravity CLI and reload MCP servers; actual client loading is not verified."
msgstr "已保存 Antigravity 工作区注册信息。请在 Antigravity CLI 中打开此项目并重新加载 MCP 服务器；尚未验证客户端实际加载情况。"

#. Key:	Message8c11093697
msgctxt "NeoStack.ClientConnectionInstall,Message8c11093697"
msgid "Claude Code project registration saved. Approve or reload it in Claude Code; actual client loading is not verified."
msgstr "已保存 Claude Code 项目注册信息。请在 Claude Code 中批准或重新加载；尚未验证客户端实际加载情况。"

#. Key:	Message346d9d84e4
msgctxt "NeoStack.ClientConnectionInstall,Message346d9d84e4"
msgid "The unchanged owned entry was removed. Other configuration and cached connector versions were retained."
msgstr "已移除未更改的受管理条目。已保留其他配置和缓存的连接器版本。"

#. Key:	Message3058b3297a
msgctxt "NeoStack.ClientConnectionOperation,Message3058b3297a"
msgid "NeoStack's connection files are missing or invalid. Update or repair the plugin, then check setup again."
msgstr "NeoStack 连接文件缺失或无效。请更新或修复插件，然后重新检查设置。"

#. Key:	Message6ba2d2e536
msgctxt "NeoStack.ClientConnectionOperation,Message6ba2d2e536"
msgid "Setup check cancelled. No registration was changed."
msgstr "已取消设置检查。注册信息未更改。"

#. Key:	Message5f3c2611b7
msgctxt "NeoStack.ClientConnectionOperation,Message5f3c2611b7"
msgid "The bundled Unreal skills are unavailable. Repair or update NeoStack before connecting."
msgstr "随附 Unreal 技能不可用。请先修复或更新 NeoStack 再连接。"

#. Key:	Messaged7344838f3
msgctxt "NeoStack.ClientConnectionOperation,Messaged7344838f3"
msgid "Update this project's connection to use the current NeoStack tools."
msgstr "请更新此项目的连接以使用当前的 NeoStack 工具。"


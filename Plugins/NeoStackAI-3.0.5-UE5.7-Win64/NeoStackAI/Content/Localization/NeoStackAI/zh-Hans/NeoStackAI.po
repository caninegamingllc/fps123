msgctxt "NeoStack.NativePluginSettingsStore,Settingc25537b20b"
msgid "Require connection authentication"
msgstr "要求连接身份验证"

#. Key:	Settingfecc63d1fb
msgctxt "NeoStack.NativePluginSettingsStore,Settingfecc63d1fb"
msgid "Require a token for browser and non-local requests. Trusted non-browser loopback clients are exempt. Applies to new requests."
msgstr "浏览器和非本地请求必须提供令牌。受信任的非浏览器回环客户端除外。应用于新请求。"

#. Key:	Setting65af77083c
msgctxt "NeoStack.NativePluginSettingsStore,Setting65af77083c"
msgid "Allowed tool patterns"
msgstr "允许的工具模式"

#. Key:	Settingc485e49eda
msgctxt "NeoStack.NativePluginSettingsStore,Settingc485e49eda"
msgid "One wildcard pattern per line. Only matching Unreal ToolsetRegistry calls are allowed; blocked patterns take priority. Empty denies all calls."
msgstr "每行一个通配符模式。仅允许匹配的 Unreal ToolsetRegistry 调用；阻止模式优先。留空会拒绝所有调用。"

#. Key:	Setting0dc0e56591
msgctxt "NeoStack.NativePluginSettingsStore,Setting0dc0e56591"
msgid "One wildcard pattern per line. Applies to new calls; existing work is not canceled."
msgstr "每行一个通配符模式。应用于新调用；现有工作不会取消。"

#. Key:	Setting9ac6dfcbbb
msgctxt "NeoStack.NativePluginSettingsStore,Setting9ac6dfcbbb"
msgid "Blocked tool patterns"
msgstr "阻止的工具模式"

#. Key:	Setting20f7e859ed
msgctxt "NeoStack.NativePluginSettingsStore,Setting20f7e859ed"
msgid "1–300 seconds. Stops waiting, but cannot cancel work already running inside Unreal ToolsetRegistry."
msgstr "1–300 秒。停止等待，但无法取消已在 Unreal ToolsetRegistry 内运行的工作。"

#. Key:	Setting66e837e09e
msgctxt "NeoStack.NativePluginSettingsStore,Setting66e837e09e"
msgid "Unreal tool wait timeout (seconds)"
msgstr "Unreal 工具等待超时（秒）"

#. Key:	Setting8d5219c4ee
msgctxt "NeoStack.NativePluginSettingsStore,Setting8d5219c4ee"
msgid "30–1800 seconds for new OpenAI-compatible streaming requests. Does not change ACP agent timeouts."
msgstr "新 OpenAI 兼容流式请求为 30–1800 秒。不更改 ACP 智能体超时。"

#. Key:	Settingb93d741acd
msgctxt "NeoStack.NativePluginSettingsStore,Settingb93d741acd"
msgid "HTTP chat timeout (seconds)"
msgstr "HTTP 聊天超时（秒）"

#. Key:	Setting9f956d07db
msgctxt "NeoStack.NativePluginSettingsStore,Setting9f956d07db"
msgid "Desktop discovery file"
msgstr "桌面发现文件"

#. Key:	Settinge8c6a701c1
msgctxt "NeoStack.NativePluginSettingsStore,Settinge8c6a701c1"
msgid "Leave empty for automatic project discovery. Restart to apply."
msgstr "留空以自动发现项目。重启后生效。"

#. Key:	Settingae72f1f174
msgctxt "NeoStack.NativePluginSettingsStore,Settingae72f1f174"
msgid "Agent runtime executable"
msgstr "智能体运行时可执行文件"

#. Key:	Settingbfd92a78b7
msgctxt "NeoStack.NativePluginSettingsStore,Settingbfd92a78b7"
